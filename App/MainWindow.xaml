                                                <TextBlock Text="Poll:" Foreground="{DynamicResource TextDimBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" FontSize="10.5"/>
                                                <ComboBox x:Name="IntervalCombo" Width="62" Height="26" FontSize="10.5" SelectionChanged="IntervalCombo_Changed">
                                                    <ComboBoxItem Content="1s" Tag="1000"/>
                                                    <ComboBoxItem Content="2s" Tag="2000"/>
                                                    <ComboBoxItem Content="5s" Tag="5000"/>
                                                </ComboBox>
                                                <Button Content="↻ Quét lại" Click="RefreshBtn_Click" Margin="8,0,0,0"
                                                        Padding="10,3" FontSize="10.5"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <DataGrid x:Name="InstanceGrid" Grid.Row="1" Margin="6,4,6,6"
                                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                              Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                              RowBackground="Transparent" AlternationCount="2"
                                              GridLinesVisibility="None" HeadersVisibility="Column"
                                              CanUserResizeRows="False" CanUserAddRows="False" RowHeaderWidth="0"
                                              HorizontalScrollBarVisibility="Disabled"
                                              FontSize="11.5"
                                              RowStyle="{StaticResource GlassGridRow}"
                                              CellStyle="{StaticResource GlassGridCell}"
                                              ColumnHeaderStyle="{StaticResource GlassGridHeader}"
                                              MouseDoubleClick="InstanceGrid_MouseDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="36"/>
                                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="64"/>
                                            <DataGridTextColumn Header="Tên cửa sổ" Binding="{Binding WindowTitle}" Width="*"/>
                                            <DataGridTextColumn Header="RAM" Binding="{Binding RamDisplay}" Width="82">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="CPU" Binding="{Binding CpuDisplay}" Width="66">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTertiaryBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="ĐÃ TREO" Binding="{Binding UptimeDisplay}" Width="92">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="92"/>
                                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplay}" Width="112">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <!-- Log -->
                            <Border Grid.Row="3" Style="{StaticResource GlassBar}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,8,6,8">
                                    <TextBlock x:Name="LogText" Text="" FontSize="10.5" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>

