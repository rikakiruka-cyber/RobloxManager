                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Padding="16,10" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1">
