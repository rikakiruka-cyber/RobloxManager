                                               Foreground="{DynamicResource AccentWarningBrush}" VerticalAlignment="Center"/>
                                </WrapPanel>
                            </Border>

                            <!-- Danh sách Roblox -->
                            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="0,0,0,10">
