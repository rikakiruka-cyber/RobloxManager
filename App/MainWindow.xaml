<Window x:Class="RobloxRAMManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox RAM Manager — Studio Edition · by RikaSoora" Icon="Assets/app.ico" Width="1060" Height="740"
        MinWidth="860" MinHeight="580"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="WindowRoot" ClipToBounds="True">

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!--  AURORA BACKGROUND (động, vẽ bằng gradient — không blur)    -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Rectangle Fill="{DynamicResource BgBrush}"/>

        <Viewbox Stretch="Fill" IsHitTestVisible="False">
            <Canvas x:Name="AuroraCanvas" Width="1000" Height="700">

                <!-- Dải sáng lớn: xanh lục (góc dưới trái) -->
                <Ellipse x:Name="AurA" Width="840" Height="640" Canvas.Left="-280" Canvas.Top="330"
                         Fill="{DynamicResource AuroraBlobA}" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.CacheMode><BitmapCache/></Ellipse.CacheMode>
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="AurA_Scale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="AurA_Move"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Dải sáng lớn: cyan (góc trên phải) -->
                <Ellipse x:Name="AurB" Width="780" Height="580" Canvas.Left="520" Canvas.Top="-230"
                         Fill="{DynamicResource AuroraBlobB}" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.CacheMode><BitmapCache/></Ellipse.CacheMode>
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="AurB_Scale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="AurB_Move"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Vầng tím nhạt ở giữa -->
                <Ellipse x:Name="AurC" Width="640" Height="480" Canvas.Left="250" Canvas.Top="190"
                         Fill="{DynamicResource AuroraBlobC}" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.CacheMode><BitmapCache/></Ellipse.CacheMode>
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="AurC_Scale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="AurC_Move"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Dải ribbon 1 (nghiêng lên) -->
                <Ellipse x:Name="AurR1" Width="1100" Height="190" Canvas.Left="-60" Canvas.Top="170"
                         Fill="{DynamicResource AuroraRibbonA}" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.CacheMode><BitmapCache/></Ellipse.CacheMode>
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="AurR1_Rot" Angle="-22"/>
                            <TranslateTransform x:Name="AurR1_Move"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Dải ribbon 2 (nghiêng xuống) -->
                <Ellipse x:Name="AurR2" Width="980" Height="150" Canvas.Left="120" Canvas.Top="440"
                         Fill="{DynamicResource AuroraRibbonB}" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.CacheMode><BitmapCache/></Ellipse.CacheMode>
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="AurR2_Rot" Angle="18"/>
                            <TranslateTransform x:Name="AurR2_Move"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
        </Viewbox>

        <!-- Làm tối viền để chữ dễ đọc -->
        <Rectangle Fill="{DynamicResource VignetteBrush}" IsHitTestVisible="False"/>

        <!-- Mascot làm hình nền (góc dưới phải, mờ, bồng bềnh nhẹ) -->
        <Image Source="Assets/mascot.png" Width="520" Height="520"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,-6"
               Opacity="0.28" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.RenderTransform>
                <TranslateTransform x:Name="MascotFloat" Y="0"/>
            </Image.RenderTransform>
        </Image>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!--  LAYOUT CHÍNH                                                -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ───────── THANH TIÊU ĐỀ ───────── -->
            <Border Grid.Row="0" Background="{DynamicResource GlassDeepBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="Assets/mascot.png" Width="32" Height="32" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="ROBLOX RAM MANAGER" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Background="{DynamicResource HoverBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock x:Name="EngineLabel" FontSize="9.5" Foreground="{DynamicResource AccentWarningBrush}" Text="Engine: Checking..."/>
                        </Border>
                        <TextBlock x:Name="AuthorLabel" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="14,0,8,0"/>
                        <Button Click="AuthorDiscord_Click" ToolTip="Mở Discord của tác giả" Padding="9,3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                    <Path Fill="{DynamicResource AccentPrimaryBrush}" Data="M19.27,4.42 C17.81,3.75 16.27,3.26 14.65,3 C14.45,3.36 14.22,3.84 14.06,4.22 C12.33,3.96 10.63,3.96 8.94,4.22 C8.78,3.84 8.54,3.36 8.34,3 C6.72,3.26 5.17,3.75 3.73,4.43 C0.8,8.81 0.01,13.08 0.41,17.29 C2.36,18.73 4.25,19.61 6.11,20.19 C6.57,19.56 6.98,18.89 7.33,18.18 C6.66,17.93 6.02,17.61 5.41,17.23 C5.57,17.11 5.73,16.99 5.88,16.86 C9.87,18.7 14.16,18.7 18.11,16.86 C18.27,16.99 18.43,17.11 18.59,17.23 C17.98,17.61 17.34,17.93 16.66,18.18 C17.02,18.89 17.43,19.56 17.89,20.19 C19.75,19.61 21.65,18.73 23.6,17.29 C24.08,12.39 22.8,8.16 19.27,4.42 Z M8.52,14.68 C7.34,14.68 6.38,13.59 6.38,12.26 C6.38,10.93 7.31,9.84 8.52,9.84 C9.73,9.84 10.68,10.94 10.65,12.26 C10.65,13.59 9.73,14.68 8.52,14.68 Z M15.48,14.68 C14.3,14.68 13.34,13.59 13.34,12.26 C13.34,10.93 14.28,9.84 15.48,9.84 C16.69,9.84 17.65,10.94 17.62,12.26 C17.62,13.59 16.7,14.68 15.48,14.68 Z"/>
                                </Viewbox>
                                <TextBlock Text="Discord" FontSize="10.5"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="SendDiscordWebhook_Click" ToolTip="Gửi báo cáo Discord ngay"
                                Padding="10,4" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                    <Path Fill="{DynamicResource AccentPrimaryBrush}"
                                          Data="M2,21 L23,12 L2,3 L2,10 L17,12 L2,14 Z"/>
                                </Viewbox>
                                <TextBlock Text="Gửi Discord" FontSize="10.5"/>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="ClockLabel" Text="00:00:00" FontSize="12.5" FontFamily="Consolas"
                                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <Button x:Name="MinBtn" Style="{StaticResource WinButton}" Click="MinBtn_Click" ToolTip="Thu nhỏ">
                            <Path Data="M0,0 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" Margin="0,5,0,0"/>
                        </Button>
                        <Button x:Name="MaxBtn" Style="{StaticResource WinButton}" Click="MaxBtn_Click" ToolTip="Phóng to / Thu về">
                            <Path x:Name="MaxGlyph" Data="M0,0 H10 V10 H0 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"/>
                        </Button>
                        <Button x:Name="CloseBtn" Style="{StaticResource WinCloseButton}" Click="CloseBtn_Click" ToolTip="Đóng">
                            <Path Data="M0,0 L10,10 M10,0 L0,10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ───────── THÂN: SIDEBAR + NỘI DUNG ───────── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══ SIDEBAR ═══ -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" CornerRadius="16" Margin="12,12,0,12">
                    <Grid>
                        <StackPanel VerticalAlignment="Top" Margin="0,10,0,0" HorizontalAlignment="Center">
                            <Button x:Name="NavHomeBtn" Click="NavHome_Click" ToolTip="Tổng quan hệ thống (Overview)"
                                    Style="{StaticResource NavButton}" Margin="0,0,0,6"
                                    Background="{DynamicResource GlassActiveBrush}">
                                <Viewbox Width="20" Height="20">
                                    <Path x:Name="NavHomeIcon" Fill="{DynamicResource AccentPrimaryBrush}"
                                          Data="M10,20 L10,14 L14,14 L14,20 L19,20 L19,10 L22,10 L12,1 L2,10 L5,10 L5,20 Z"/>
                                </Viewbox>
                            </Button>

                            <Button x:Name="NavDiscordBtn" Click="NavDiscord_Click" ToolTip="Cấu hình Discord Webhook Bot"
                                    Style="{StaticResource NavButton}" Margin="0,0,0,6">
                                <Viewbox Width="20" Height="20">
                                    <Path x:Name="NavDiscordIcon" Fill="{DynamicResource TextDimBrush}"
                                          Data="M19.27,4.42 C17.81,3.75 16.27,3.26 14.65,3 C14.45,3.36 14.22,3.84 14.06,4.22 C12.33,3.96 10.63,3.96 8.94,4.22 C8.78,3.84 8.54,3.36 8.34,3 C6.72,3.26 5.17,3.75 3.73,4.43 C0.8,8.81 0.01,13.08 0.41,17.29 C2.36,18.73 4.25,19.61 6.11,20.19 C6.57,19.56 6.98,18.89 7.33,18.18 C6.66,17.93 6.02,17.61 5.41,17.23 C5.57,17.11 5.73,16.99 5.88,16.86 C9.87,18.7 14.16,18.7 18.11,16.86 C18.27,16.99 18.43,17.11 18.59,17.23 C17.98,17.61 17.34,17.93 16.66,18.18 C17.02,18.89 17.43,19.56 17.89,20.19 C19.75,19.61 21.65,18.73 23.6,17.29 C24.08,12.39 22.8,8.16 19.27,4.42 Z M8.52,14.68 C7.34,14.68 6.38,13.59 6.38,12.26 C6.38,10.93 7.31,9.84 8.52,9.84 C9.73,9.84 10.68,10.94 10.65,12.26 C10.65,13.59 9.73,14.68 8.52,14.68 Z M15.48,14.68 C14.3,14.68 13.34,13.59 13.34,12.26 C13.34,10.93 14.28,9.84 15.48,9.84 C16.69,9.84 17.65,10.94 17.62,12.26 C17.62,13.59 16.7,14.68 15.48,14.68 Z"/>
                                </Viewbox>
                            </Button>

                            <Button x:Name="NavAccountBtn" Click="NavAccount_Click" ToolTip="Quản lý tài khoản Roblox"
                                    Style="{StaticResource NavButton}" Margin="0,0,0,6">
                                <Viewbox Width="20" Height="20">
                                    <Path x:Name="NavAccountIcon" Fill="{DynamicResource TextDimBrush}"
                                          Data="M12,12 A4,4 0 1,0 12,4 A4,4 0 1,0 12,12 M12,14 C7.6,14 4,16.2 4,19 L4,21 L20,21 L20,19 C20,16.2 16.4,14 12,14 Z"/>
                                </Viewbox>
                            </Button>

                            <Button Click="OptimizeAll_Click" ToolTip="Tối ưu nhanh toàn bộ (Trim + Cap CPU)"
                                    Style="{StaticResource NavButton}" Margin="0,0,0,6">
                                <Viewbox Width="20" Height="20">
                                    <Path Fill="{DynamicResource AccentWarningBrush}"
                                          Data="M13,2 L3,14 L10,14 L8,22 L18,10 L11,10 Z"/>
                                </Viewbox>
                            </Button>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,14" HorizontalAlignment="Center">
                            <Button x:Name="HelpBtn" Click="HelpBtn_Click" ToolTip="Trợ giúp / Help"
                                    Style="{StaticResource NavButton}" Margin="0,0,0,12">
                                <Viewbox Width="20" Height="20">
                                    <Path x:Name="HelpIcon" Fill="{DynamicResource TextDimBrush}"
                                          Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 M12,17.2 A1.2,1.2 0 1,1 12,19.6 A1.2,1.2 0 1,1 12,17.2 M9.1,9 A2.9,2.9 0 0,1 12,6.3 C13.8,6.3 15.1,7.5 15.1,9 C15.1,10.3 14.3,11 13.3,11.6 C12.4,12.1 12,12.5 12,13.4 L12,14.3 L10.4,14.3 L10.4,13.2 C10.4,11.9 11,11.1 12.1,10.4 C13,9.9 13.4,9.5 13.4,8.9 C13.4,8.2 12.8,7.7 11.9,7.7 C11,7.7 10.4,8.3 10.3,9.2 Z"/>
                                </Viewbox>
                            </Button>

                            <Button x:Name="SettingsBtn" Click="SettingsBtn_Click" ToolTip="Cài đặt hệ thống (Settings)"
                                    Style="{StaticResource NavButton}" Margin="0,0,0,12">
                                <Viewbox Width="22" Height="22" RenderTransformOrigin="0.5,0.5">
                                    <Viewbox.RenderTransform>
                                        <RotateTransform x:Name="SettingsGearRotate" Angle="0"/>
                                    </Viewbox.RenderTransform>
                                    <Path x:Name="SettingsGearPath" Fill="{DynamicResource TextDimBrush}"
                                          Data="M12,8 A4,4 0 1,0 12,16 A4,4 0 1,0 12,8 M12,10 A2,2 0 1,1 12,14 A2,2 0 1,1 12,10 M11,1 L13,1 L13.5,4 L14.5,4.4 L17,2.5 L18.5,4 L16.6,6.5 L17,7.5 L20,8 L20,10 L17,10.5 L16.6,11.5 L18.5,14 L17,15.5 L14.5,13.6 L13.5,14 L13,17 L11,17 L10.5,14 L9.5,13.6 L7,15.5 L5.5,14 L7.4,11.5 L7,10.5 L4,10 L4,8 L7,7.5 L7.4,6.5 L5.5,4 L7,2.5 L9.5,4.4 L10.5,4 Z"/>
                                </Viewbox>
                            </Button>

                            <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="{DynamicResource AccentPrimaryBrush}" ToolTip="Monitor Online"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ KHU NỘI DUNG ═══ -->
                <Grid Grid.Column="1" Margin="12,12,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Thanh tab -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                        <StackPanel x:Name="TabBarPanel" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="TabOverviewBtn" Click="NavHome_Click"
                                    Background="{DynamicResource GlassActiveBrush}"
                                    BorderBrush="{DynamicResource AccentPrimaryBrush}"
                                    Padding="14,7" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                                        <Path Fill="{DynamicResource AccentPrimaryBrush}"
                                              Data="M10,20 L10,14 L14,14 L14,20 L19,20 L19,10 L22,10 L12,1 L2,10 L5,10 L5,20 Z"/>
                                    </Viewbox>
                                    <TextBlock Text="Tổng quan" FontWeight="SemiBold" FontSize="11.5"/>
                                </StackPanel>
                            </Button>
                            <!-- Tab Roblox được thêm từ code-behind -->
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Vùng nội dung -->
                    <Grid Grid.Row="1">

                        <!-- ═══════ VIEW 1: TỔNG QUAN ═══════ -->
                        <Grid x:Name="OverviewView" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="84"/>
                            </Grid.RowDefinitions>

                            <!-- Thẻ thống kê -->
                            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,10">
                                <!-- RAM -->
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,6,0" Padding="16,13">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource HoverBrush}" Margin="0,0,8,0">
                                                <Viewbox Width="14" Height="14">
                                                    <Path Fill="{DynamicResource AccentPrimaryBrush}"
                                                          Data="M5,3 L19,3 L19,21 L5,21 Z M8,6 L16,6 L16,18 L8,18 Z M3,7 L5,7 L5,9 L3,9 Z M3,11 L5,11 L5,13 L3,13 Z M19,7 L21,7 L21,9 L19,9 Z M19,11 L21,11 L21,13 L19,13 Z"/>
                                                </Viewbox>
                                            </Border>
                                            <TextBlock Text="RAM HỆ THỐNG" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                        </StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Border Background="{DynamicResource BarTrackBrush}" CornerRadius="5" Height="10"/>
                                            <Border x:Name="RamBarFill" Background="{DynamicResource RamBarGradient}"
                                                    CornerRadius="5" Height="10" HorizontalAlignment="Left" Width="0"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock x:Name="RamLabel" Text="0 / 0 GB" FontSize="11.5" VerticalAlignment="Bottom"/>
                                            <TextBlock x:Name="RamPercent" Text="0%" FontSize="22" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CPU -->
                                <Border Style="{StaticResource GlassCard}" Margin="3,0,3,0" Padding="16,13">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource HoverBrush}" Margin="0,0,8,0">
                                                <Viewbox Width="14" Height="14">
                                                    <Path Fill="{DynamicResource AccentTertiaryBrush}"
                                                          Data="M5,5 L19,5 L19,19 L5,19 Z M8,8 L16,8 L16,16 L8,16 Z M8,2 L10,2 L10,5 L8,5 Z M14,2 L16,2 L16,5 L14,5 Z M8,19 L10,19 L10,22 L8,22 Z M14,19 L16,19 L16,22 L14,22 Z M2,8 L5,8 L5,10 L2,10 Z M2,14 L5,14 L5,16 L2,16 Z M19,8 L22,8 L22,10 L19,10 Z M19,14 L22,14 L22,16 L19,16 Z"/>
                                                </Viewbox>
                                            </Border>
                                            <TextBlock Text="CPU HỆ THỐNG" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTertiaryBrush}"/>
                                        </StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Border Background="{DynamicResource BarTrackBrush}" CornerRadius="5" Height="10"/>
                                            <Border x:Name="CpuBarFill" Background="{DynamicResource CpuBarGradient}"
                                                    CornerRadius="5" Height="10" HorizontalAlignment="Left" Width="0"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock x:Name="CpuLabel" Text="Processors: 0" FontSize="11.5" VerticalAlignment="Bottom"/>
                                            <TextBlock x:Name="CpuPercent" Text="0%" FontSize="22" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentTertiaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Tài khoản -->
                                <Border Style="{StaticResource GlassCard}" Margin="6,0,0,0" Padding="16,13">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource HoverBrush}" Margin="0,0,8,0">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Fill="{DynamicResource AccentWarningBrush}"
                                                              Data="M12,4 A3,3 0 1,1 12,10 A3,3 0 1,1 12,4 M5,20 L5,18 A7,4 0 0,1 19,18 L19,20 Z"/>
                                                    </Viewbox>
                                                </Border>
                                                <TextBlock Text="TÀI KHOẢN TREO" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentWarningBrush}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="ManagerUptimeLabel" Text="⏱️ 00:00" FontSize="10.5"
                                                       Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="22"/>
                                                <RowDefinition Height="22"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Đang chạy:" Foreground="{DynamicResource TextDimBrush}" FontSize="11.5"/>
                                            <TextBlock x:Name="ActiveAccLabel" Grid.Column="1" Text="0" FontWeight="Bold" FontSize="14"
                                                       Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                            <TextBlock Grid.Row="1" Text="Crash / Văng:" Foreground="{DynamicResource TextDimBrush}" FontSize="11.5"/>
                                            <TextBlock x:Name="CrashedAccLabel" Grid.Row="1" Grid.Column="1" Text="0" FontWeight="Bold" FontSize="14"
                                                       Foreground="{DynamicResource AccentDangerBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Thanh công cụ -->
                            <Border Grid.Row="1" Style="{StaticResource GlassBar}" Padding="14,9" Margin="0,0,0,10">
                                <WrapPanel VerticalAlignment="Center">
                                    <CheckBox x:Name="AutoModeChk" VerticalAlignment="Center" Margin="0,0,8,0"
