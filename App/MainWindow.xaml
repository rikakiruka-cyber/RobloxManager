                                        <ComboBoxItem Content="Below Normal" Tag="16384"/>
                                        <ComboBoxItem Content="Normal" Tag="32"/>
                                        <ComboBoxItem Content="Above Normal" Tag="32768"/>
                                        <ComboBoxItem Content="High" Tag="128"/>
