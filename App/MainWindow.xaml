                                            <TextBlock Text="🚀 Mở acc" FontSize="11.5"/>
                                        </Button>
                                        <Button Click="AccLaunchAll_Click" Padding="16,8" Margin="0,0,10,0">
                                            <TextBlock Text="🚀 Mở tất cả" FontSize="11.5"/>
                                        </Button>
                                        <Button Click="AccNew_Click" Padding="16,8" Margin="0,0,10,0">
                                            <TextBlock Text="➕ Acc mới" FontSize="11.5"/>
                                        </Button>
                                        <Button Click="AccDelete_Click" Padding="16,8">
                                            <TextBlock Text="🗑 Xoá" FontSize="11.5" Foreground="{DynamicResource AccentDangerBrush}"/>
                                        </Button>
                                    </StackPanel>

                                    <TextBlock x:Name="AccStatusLabel" Text="" FontSize="11.5"
                                               Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Footer -->
                    <Border Grid.Row="2" Style="{StaticResource GlassBar}" CornerRadius="10" Padding="14,6" Margin="0,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusText" Text="Studio Ready" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ModeLabel" Grid.Column="1" Text="Manual" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentWarningBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ThemeLabel" Grid.Column="2" Text="aurora" FontSize="10.5"
                                       Foreground="{DynamicResource TextDimBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!--  SETTINGS OVERLAY (trượt từ phải)                            -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Grid x:Name="SettingsOverlay" Grid.ColumnSpan="2" Visibility="Collapsed">
                    <Border Background="#66000000" MouseDown="SettingsBackdrop_Click"/>
                    <Border x:Name="SettingsPanel" Width="310" HorizontalAlignment="Right"
                            Background="{DynamicResource PopupBrush}"
                            BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1,1,0,0"
                            CornerRadius="18,0,0,0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="SettingsTranslate" X="0"/>
                        </Border.RenderTransform>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20,18">
                                <Grid Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                            <Path Fill="{DynamicResource AccentPrimaryBrush}"
                                                  Data="M12,8 A4,4 0 1,0 12,16 A4,4 0 1,0 12,8 M12,10 A2,2 0 1,1 12,14 A2,2 0 1,1 12,10 M11,1 L13,1 L13.5,4 L14.5,4.4 L17,2.5 L18.5,4 L16.6,6.5 L17,7.5 L20,8 L20,10 L17,10.5 L16.6,11.5 L18.5,14 L17,15.5 L14.5,13.6 L13.5,14 L13,17 L11,17 L10.5,14 L9.5,13.6 L7,15.5 L5.5,14 L7.4,11.5 L7,10.5 L4,10 L4,8 L7,7.5 L7.4,6.5 L5.5,4 L7,2.5 L9.5,4.4 L10.5,4 Z"/>
                                        </Viewbox>
                                        <TextBlock Text="CÀI ĐẶT HỆ THỐNG" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                    </StackPanel>
                                    <Button Content="✕" HorizontalAlignment="Right" Click="CloseSettings_Click"
                                            Background="Transparent" BorderThickness="0" FontSize="14"
                                            Foreground="{DynamicResource TextDimBrush}" Padding="8,2"/>
                                </Grid>

                                <TextBlock Text="CHỦ ĐỀ GIAO DIỆN" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="ThemeList" Margin="0,0,0,22"/>

                                <TextBlock Text="HIỆU ỨNG" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentWarningBrush}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="AuroraChk" Content="Aurora chuyển động (tắt để nhẹ máy hơn)"
                                          FontSize="11.5" Margin="0,0,0,22"
                                          Checked="Aurora_Changed" Unchecked="Aurora_Changed"/>

                                <TextBlock Text="HIỆU NĂNG &amp; TỐI ƯU" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentWarningBrush}" Margin="0,0,0,10"/>

                                <TextBlock Text="Giới hạn CPU (Hard Cap mỗi Acc)" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,14">
                                    <Slider x:Name="CpuCapSlider" Minimum="10" Maximum="90" Value="40"
                                            TickFrequency="10" IsSnapToTickEnabled="True"
                                            ValueChanged="CpuCapSlider_Changed"/>
                                    <TextBlock x:Name="CpuCapLabel" Text="40%" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,0,0"
                                               FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentWarningBrush}"/>
                                </Grid>

                                <TextBlock Text="Giới hạn RAM (mỗi Acc, tự dọn khi vượt)" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,14">
                                    <Slider x:Name="RamCapSlider" Minimum="0" Maximum="4096" Value="0"
                                            TickFrequency="256" IsSnapToTickEnabled="True"
                                            ValueChanged="RamCapSlider_Changed"/>
                                    <TextBlock x:Name="RamCapLabel" Text="Tắt" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,0,0"
                                               FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentWarningBrush}"/>
                                </Grid>

                                <TextBlock Text="Tự động dọn RAM (Auto-Trim)" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="TrimIntervalCombo" Width="150" HorizontalAlignment="Left" FontSize="11"
                                          Margin="0,0,0,14" SelectionChanged="TrimInterval_Changed">
                                    <ComboBoxItem Content="Mỗi 5 giây" Tag="5"/>
                                    <ComboBoxItem Content="Mỗi 10 giây" Tag="10"/>
                                    <ComboBoxItem Content="Mỗi 20 giây" Tag="20"/>
                                    <ComboBoxItem Content="Mỗi 30 giây" Tag="30"/>
                                    <ComboBoxItem Content="Tắt" Tag="0"/>
                                </ComboBox>

                                <TextBlock Text="Tần suất quét tiến trình (Poll)" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="PollCombo" Width="150" HorizontalAlignment="Left" FontSize="11"
                                          Margin="0,0,0,22" SelectionChanged="PollCombo_Changed">
                                    <ComboBoxItem Content="1 giây" Tag="1000"/>
                                    <ComboBoxItem Content="2 giây" Tag="2000"/>
                                    <ComboBoxItem Content="5 giây" Tag="5000"/>
                                </ComboBox>

                                <TextBlock Text="NGÔN NGỮ" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentWarningBrush}" Margin="0,0,0,10"/>
                                <UniformGrid Columns="2" Margin="0,0,0,22">
                                    <Button x:Name="SetLangViBtn" Content="🇻🇳 Tiếng Việt" Click="SetLangVi_Click"
                                            Margin="0,0,4,0" Padding="0,7" FontSize="11" FontWeight="Bold"/>
                                    <Button x:Name="SetLangEnBtn" Content="🇬🇧 English" Click="SetLangEn_Click"
                                            Margin="4,0,0,0" Padding="0,7" FontSize="11" FontWeight="Bold"/>
                                </UniformGrid>

                                <TextBlock Text="DỮ LIỆU" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentWarningBrush}" Margin="0,0,0,10"/>
                                <TextBlock x:Name="DataPathLabel" FontSize="10.5" FontFamily="Consolas" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,8"/>
                                <UniformGrid Columns="2" Margin="0,0,0,22">
                                    <Button Content="📁 Mở thư mục" Click="OpenDataDir_Click"
                                            Margin="0,0,4,0" Padding="0,7" FontSize="11" FontWeight="Bold"/>
                                    <Button Content="🔀 Đổi nơi lưu" Click="ChangeDataDir_Click"
                                            Margin="4,0,0,0" Padding="0,7" FontSize="11" FontWeight="Bold"/>
                                </UniformGrid>

                                <TextBlock Text="CẬP NHẬT" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentWarningBrush}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="AutoUpdateChk" Content="Tự kiểm tra bản cập nhật khi mở app" IsChecked="True"
                                          Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed" FontSize="11.5" Margin="0,0,0,10"/>
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="🔄 Kiểm tra cập nhật" Click="CheckUpdate_Click"
                                            Padding="12,7" FontSize="11" FontWeight="Bold" Margin="0,0,8,6"/>
                                    <Button Content="📜 Lịch sử cập nhật" Click="Changelog_Click"
                                            Padding="12,7" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                </WrapPanel>
                                <TextBlock x:Name="UpdateStatusLabel" FontSize="10.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,22"/>

                                <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="THÔNG TIN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="AboutText" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!--  HELP OVERLAY (trượt từ trái / slides in from the left)      -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Grid x:Name="HelpOverlay" Grid.ColumnSpan="2" Visibility="Collapsed">
                    <Border Background="#66000000" MouseDown="HelpBackdrop_Click"/>
                    <Border x:Name="HelpPanel" Width="340" HorizontalAlignment="Left"
                            Background="{DynamicResource PopupBrush}"
                            BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="0,1,1,0"
                            CornerRadius="0,18,18,0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="HelpTranslate" X="-340"/>
                        </Border.RenderTransform>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20,18">
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                            <Path Fill="{DynamicResource AccentPrimaryBrush}"
                                                  Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 M12,17.2 A1.2,1.2 0 1,1 12,19.6 A1.2,1.2 0 1,1 12,17.2 M9.1,9 A2.9,2.9 0 0,1 12,6.3 C13.8,6.3 15.1,7.5 15.1,9 C15.1,10.3 14.3,11 13.3,11.6 C12.4,12.1 12,12.5 12,13.4 L12,14.3 L10.4,14.3 L10.4,13.2 C10.4,11.9 11,11.1 12.1,10.4 C13,9.9 13.4,9.5 13.4,8.9 C13.4,8.2 12.8,7.7 11.9,7.7 C11,7.7 10.4,8.3 10.3,9.2 Z"/>
                                        </Viewbox>
                                        <TextBlock x:Name="HelpTitleLabel" Text="TRỢ GIÚP" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                    </StackPanel>
                                    <Button Content="✕" HorizontalAlignment="Right" Click="CloseHelp_Click"
                                            Background="Transparent" BorderThickness="0" FontSize="14"
                                            Foreground="{DynamicResource TextDimBrush}" Padding="8,2"/>
                                </Grid>

                                <!-- Language switch -->
                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <Button x:Name="LangViBtn" Content="Tiếng Việt" Click="LangVi_Click"
                                            Margin="0,0,4,0" Padding="0,6" FontSize="11" FontWeight="Bold"
                                            Background="{DynamicResource GlassActiveBrush}"/>
                                    <Button x:Name="LangEnBtn" Content="English" Click="LangEn_Click"
                                            Margin="4,0,0,0" Padding="0,6" FontSize="11" FontWeight="Bold"/>
                                </UniformGrid>

                                <!-- ── Nội dung Tiếng Việt ── -->
                                <StackPanel x:Name="HelpContentVi" Visibility="Visible">
                                    <TextBlock Text="BẮT ĐẦU NHANH" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentWarningBrush}" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="18" Margin="0,0,0,18"
                                               Text="Ứng dụng tự quét các tiến trình RobloxPlayerBeta.exe đang chạy và hiển thị RAM, CPU, Disk, Network theo thời gian thực. Mỗi tài khoản xuất hiện dưới dạng một dòng trong bảng ở tab Tổng quan."/>

                                    <TextBlock Text="CÁC NÚT CHỨC NĂNG" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentWarningBrush}" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="18" Margin="0,0,0,18"
                                               Text="• Tối Ưu Tất Cả: dọn RAM và giới hạn CPU/số core cho mọi tài khoản cùng lúc.&#x0a;• Dọn RAM (Trim): giải phóng bộ nhớ working-set của Roblox, không ảnh hưởng dữ liệu đang chơi.&#x0a;• AUTO: tự động lặp lại việc dọn RAM theo chu kỳ bạn đặt trong Cài đặt.&#x0a;• Gửi Discord: gửi báo cáo tình trạng hệ thống tới webhook Discord đã cấu hình."/>

                                    <TextBlock Text="CHỈ SỐ CPU" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentWarningBrush}" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="18" Margin="0,0,0,18"
                                               Text="% CPU của mỗi tài khoản đã được chuẩn hoá theo số nhân (core) của máy, giống Task Manager — tối đa 100%. Ô CPU HỆ THỐNG ở trên là tổng tải của toàn máy, có thể khác với widget RAM/CPU bên ngoài (ví dụ Rainmeter) vì mỗi công cụ lấy mẫu tại thời điểm khác nhau."/>

                                    <TextBlock Text="CÀI ĐẶT" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentWarningBrush}" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="18" Margin="0,0,0,4"
                                               Text="Bấm biểu tượng bánh răng để đổi theme, bật/tắt hiệu ứng Aurora, chỉnh giới hạn CPU, chu kỳ Auto-Trim và tần suất quét."/>
                                </StackPanel>

                                <!-- ── English content ── -->
                                <StackPanel x:Name="HelpContentEn" Visibility="Collapsed">
                                    <TextBlock Text="QUICK START" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentWarningBrush}" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="18" Margin="0,0,0,18"
                                               Text="The app scans running RobloxPlayerBeta.exe processes and shows live RAM, CPU, Disk and Network for each one. Every account shows up as a row in the Overview tab's table."/>

                                    <TextBlock Text="ACTION BUTTONS" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentWarningBrush}" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="18" Margin="0,0,0,18"
                                               Text="• Optimize All: trims RAM and caps CPU/core count for every account at once.&#x0a;• Trim RAM: releases Roblox's working-set memory without affecting your session.&#x0a;• AUTO: repeats the RAM trim automatically on the interval set in Settings.&#x0a;• Send Discord: posts a system status report to your configured Discord webhook."/>

                                    <TextBlock Text="ABOUT THE CPU READING" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentWarningBrush}" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="18" Margin="0,0,0,18"
                                               Text="Each account's CPU% is normalized by core count, like Task Manager — capped at 100%. The SYSTEM CPU card above is whole-machine load, so it can differ from an external RAM/CPU widget (e.g. Rainmeter) since each tool samples at a different moment."/>

                                    <TextBlock Text="SETTINGS" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentWarningBrush}" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="18" Margin="0,0,0,4"
                                               Text="Click the gear icon to change theme, toggle the Aurora animation, and adjust the CPU cap, Auto-Trim interval and poll rate."/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
