                                    </Button>

                                    <Rectangle Width="1" Height="20" Fill="{DynamicResource PanelBorderBrush}" Margin="0,0,14,0"/>

                                    <TextBlock Text="Priority:" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
