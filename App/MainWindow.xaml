                                            <TextBlock Text="DANH SÁCH ROBLOX ĐANG TREO  ·  nhấp đúp để mở chi tiết"
                                                       FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
